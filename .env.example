# ── Auth (better-auth) ─────────────────────────────────────────────
# Secret used to sign session cookies (min 32 chars).
BETTER_AUTH_SECRET=your-secret-key-min-32-chars
# API origin — used as cookie/callback base URL.
BETTER_AUTH_URL=http://localhost:8787

# Google OAuth (optional — enables the Google sign-in button when set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email (optional — enables email verification when set)
RESEND_API_KEY=
RESEND_FROM=no-reply@7okko.com

# ── AI (OpenAI-compatible LLM client) ──────────────────────────────
# Real AI is used whenever a non-mock key is set; otherwise the
# deterministic mock generator is used. Set LLM_FORCE_MOCK=1 to force
# mock even with a key.
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# Optional — defaults to DeepSeek (https://api.deepseek.com/v1).
# Swap for any OpenAI-compatible provider: OpenAI, Synthetic/Kimi, etc.
LLM_BASE_URL=
LLM_FORCE_MOCK=

# ── Payments (Xendit) — optional; falls back to WhatsApp flow when unset ──
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_FORCE_MOCK=

# ── Payments (SingaPay) — primary provider; sandbox by default ──
# Credentials from the SingaPay merchant dashboard. Sandbox-safe: without a
# full credential set the deterministic mock is used.
SINGAPAY_CLIENT_ID=
SINGAPAY_CLIENT_SECRET=
SINGAPAY_PARTNER_ID=
SINGAPAY_ACCOUNT_ID=
# API base — sandbox default; production host when going live.
SINGAPAY_API_URL=https://sandbox-payment-b2b.singapay.id
# Base host for merchant KYB self-onboarding links (SingaPay echoes the
# caller's Host, which through a proxy would be unusable).
SINGAPAY_KYB_URL_BASE=https://sandbox-payment-b2b.singapay.id
# Optional static-IP reverse proxy (VPS) — overrides the API base so SingaPay
# sees the proxy's fixed egress IP. Leave empty to call SingaPay directly.
SINGAPAY_PROXY_URL=
# Optional shared secret the proxy requires (X-Proxy-Token header).
SINGAPAY_PROXY_TOKEN=
# Webhook signature verification (set the same secret in the SingaPay dashboard).
SINGAPAY_WEBHOOK_SECRET=
SINGAPAY_FORCE_MOCK=

# Public API origin used for payment success/failure redirects.
API_PUBLIC_URL=

# ── Shipping (Biteship) — optional; mock rates when unset ──
BITESHIP_API_KEY=
BITESHIP_FORCE_MOCK=

# ── App ────────────────────────────────────────────────────────────
NODE_ENV=development
# Deployed frontend origin (CORS + better-auth trusted origins).
FRONTEND_URL=http://localhost:3000
# Extra comma-separated CORS origins (optional, e.g. custom domains).
ALLOWED_ORIGINS=

# ── Cloudflare (deploy tooling) ────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=
